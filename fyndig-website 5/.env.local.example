# =============================================================================
# fyndig website — environment
#
# Copy to `.env.local` (which is git-ignored) and fill in.
# Everything here is optional: with the file absent the site builds and runs
# from the static content in src/data/ and the contact form falls back to a
# pre-filled email.
# =============================================================================

# --- Backend API --------------------------------------------------------------
# The fyndig API (see ../fyndig-backend). Set this and the site will:
#   * read projects and open roles from the API, with src/data as the fallback
#   * post the contact form to /api/contact
#   * show a real application form with CV upload under each open role
#
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time, so change it
# and rebuild. No secret ever belongs in this variable.
#
# Local development:  http://localhost:4000
# Production:         https://api.your-domain.com
NEXT_PUBLIC_API_URL=

# --- Public site URL (optional) -----------------------------------------------
# Where the site lives, with no trailing slash. Used for metadata and canonical
# URLs. Leave empty until you have somewhere permanent; nothing breaks without
# it. Set it to the hosting URL now and to the real domain later — it is a
# build setting, so no code change either way.
#   https://fyndig.fly.dev      (temporary)
#   https://fyndig.com          (once the domain is live)
NEXT_PUBLIC_SITE_URL=

# --- Fallback mail route (optional) -------------------------------------------
# Used by src/app/api/contact only when NEXT_PUBLIC_API_URL is unset or the API
# is unreachable. With these unset the form opens the visitor's own mail app
# instead — an enquiry is never silently dropped.
#
# The backend is the better home for this; these exist so the site can send mail
# on its own if you deploy it without the API.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
